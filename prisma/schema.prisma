generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  name          String
  passwordHash  String
  createdAt     DateTime         @default(now())
  memberships   BusinessMember[]
  stockCounts   StockCount[]
}

model Business {
  id                  String              @id @default(cuid())
  name                String
  gstNumber           String?
  balanceDate         String              @default("03-31")
  gstFilingFrequency  String              @default("two_monthly")
  financialYearStart  String              @default("04-01")
  posLastSyncedAt     DateTime?
  posSyncEnabled      Boolean             @default(true)
  createdAt           DateTime            @default(now())
  members             BusinessMember[]
  categories          Category[]
  transactions        Transaction[]
  ingredients         Ingredient[]
  products            Product[]
  sales               Sale[]
  posSyncLogs         PosSyncLog[]
  invoices            Invoice[]
  importBatches       ImportBatch[]
  savingsGoals        SavingsGoal[]
  categorisationRules CategorisationRule[]
  invites             BusinessInvite[]
  assets              Asset[]
  tempLogs            TempLog[]
  thermometerChecks   ThermometerCalibration[]
  cleaningChecklists  CleaningChecklist[]
  supplierReceipts    SupplierReceipt[]
  trainingSignOffs    TrainingSignOff[]
  allergenItems       AllergenItem[]
}

model BusinessMember {
  id         String   @id @default(cuid())
  userId     String
  businessId String
  role       String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([userId, businessId])
}

model Category {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  slug         String
  type         String        @default("expense")
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  @@unique([businessId, slug])
}

model Transaction {
  id           String      @id @default(cuid())
  businessId   String
  categoryId   String?
  ingredientId String?
  date         DateTime
  vendor       String
  unitAmount   Float
  quantity     Float       @default(1)
  totalAmount  Float
  paymentMode  String
  amountExGst  Float
  gstAmount    Float
  amountIncGst Float
  gstType      String      @default("standard_15")
  type         String      @default("expense")
  source       String      @default("manual")
  notes        String?
  createdAt    DateTime    @default(now())
  business     Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  category     Category?   @relation(fields: [categoryId], references: [id])
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  assets       Asset[]
}

model Ingredient {
  id           String        @id @default(cuid())
  businessId   String
  name         String
  unit         String
  parLevel     Float         @default(0)
  currentStock Float         @default(0)
  qrCode       String        @unique
  createdAt    DateTime      @default(now())
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  stockCounts  StockCount[]
  transactions Transaction[]
}

model StockCount {
  id           String     @id @default(cuid())
  ingredientId String
  quantity     Float
  countedAt    DateTime   @default(now())
  countedById  String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  countedBy    User       @relation(fields: [countedById], references: [id])
}

model Product {
  id           String     @id @default(cuid())
  businessId   String
  name         String
  sku          String?
  posProductId String?
  unitPrice    Float      @default(0)
  unitsSold    Float      @default(0)
  revenue      Float      @default(0)
  cogs         Float      @default(0)
  lastSyncedAt DateTime?
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleLines    SaleLine[]

  @@unique([businessId, name])
  @@unique([businessId, posProductId])
}

model Sale {
  id           String     @id @default(cuid())
  businessId   String
  posSaleId    String
  soldAt       DateTime
  customerName String?
  totalAmount  Float
  paymentMode  String     @default("Other")
  amountExGst  Float
  gstAmount    Float
  amountIncGst Float
  source       String     @default("pos")
  createdAt    DateTime   @default(now())
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  lines        SaleLine[]

  @@unique([businessId, posSaleId])
}

model SaleLine {
  id           String   @id @default(cuid())
  saleId       String
  productId    String?
  posProductId String?
  productName  String
  quantity     Float
  unitPrice    Float
  lineTotal    Float
  notes        String?
  sale         Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id])
}

model PosSyncLog {
  id           String   @id @default(cuid())
  businessId   String
  syncedAt     DateTime @default(now())
  productsSync Int      @default(0)
  salesSync    Int      @default(0)
  status       String   @default("success")
  message      String?
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String   @id @default(cuid())
  businessId    String
  externalId    String
  subject       String
  fromEmail     String
  receivedAt    DateTime
  amount        Float?
  vendor        String?
  status        String   @default("unmatched")
  attachmentUrl String?
  fileName      String?
  fileMime      String?
  fileData      Bytes?
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  @@unique([businessId, externalId])
}

model ImportBatch {
  id         String   @id @default(cuid())
  businessId String
  filename   String
  rowCount   Int
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model SavingsGoal {
  id            String    @id @default(cuid())
  businessId    String
  name          String
  targetAmount  Float
  currentAmount Float     @default(0)
  deadline      DateTime?
  createdAt     DateTime  @default(now())
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Asset {
  id              String       @id @default(cuid())
  businessId      String
  name            String
  description     String?
  location        String?
  model           String?
  brand           String?
  quantity        Float        @default(1)
  datePurchased   DateTime
  unitCost        Float
  totalCost       Float
  transactionId   String?
  source          String       @default("csv")
  createdAt       DateTime     @default(now())
  business        Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  transaction     Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([businessId, datePurchased])
  @@index([businessId, name])
}

/** Milk/chiller or transport temperature log for FCP / council evidence */
model TempLog {
  id            String   @id @default(cuid())
  businessId    String
  kind          String   // milk_chiller | transport
  loggedAt      DateTime
  location      String   // e.g. Cart fridge, Home fridge, Chilly bin
  temperatureC  Float
  notes         String?
  recordedBy    String?
  createdAt     DateTime @default(now())
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, kind, loggedAt])
}

model ThermometerCalibration {
  id           String   @id @default(cuid())
  businessId   String
  calibratedAt DateTime
  method       String   // ice_slurry | boiling_water
  readingC     Float
  passed       Boolean  @default(true)
  notes        String?
  recordedBy   String?
  createdAt    DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, calibratedAt])
}

model CleaningChecklist {
  id          String   @id @default(cuid())
  businessId  String
  cleanedAt   DateTime
  benches     Boolean  @default(false)
  milkJugs    Boolean  @default(false)
  steamWands  Boolean  @default(false)
  notes       String?
  recordedBy  String?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, cleanedAt])
}

model SupplierReceipt {
  id          String   @id @default(cuid())
  businessId  String
  purchasedAt DateTime
  supplier    String
  items       String
  amount      Float?
  fileName    String?
  fileMime    String?
  fileData    Bytes?
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, purchasedAt])
}

model TrainingSignOff {
  id              String   @id @default(cuid())
  businessId      String
  personName      String
  personRole      String   @default("owner")
  signedAt        DateTime
  acknowledgedFcp Boolean  @default(true)
  notes           String?
  createdAt       DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, signedAt])
}

model AllergenItem {
  id             String   @id @default(cuid())
  businessId     String
  productName    String
  containsGluten Boolean  @default(false)
  containsDairy  Boolean  @default(false)
  containsSoy    Boolean  @default(false)
  containsEgg    Boolean  @default(false)
  containsPeanut Boolean  @default(false)
  containsTreeNut Boolean @default(false)
  containsFish   Boolean  @default(false)
  containsShellfish Boolean @default(false)
  containsSesame Boolean  @default(false)
  containsSulphites Boolean @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  business       Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, productName])
}

model CategorisationRule {
  id         String   @id @default(cuid())
  businessId String
  pattern    String
  categoryId String
  ruleType   String   @default("vendor")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model BusinessInvite {
  id         String   @id @default(cuid())
  businessId String
  email      String
  role       String   @default("accountant")
  token      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, email])
}
