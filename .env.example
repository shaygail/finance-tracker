# Production / local Postgres (Railway, Neon, or Docker)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Optional — accountant invite emails
# RESEND_API_KEY=
# EMAIL_FROM="Finance Tracker <onboarding@resend.dev>"
# RESEND_FROM_EMAIL="Finance Tracker <onboarding@resend.dev>"

# STLL Haus POS sync (public API preferred)
# POS_PRESET=stllhaus
# POS_API_URL=https://stllhaus-pos-production.up.railway.app
# Or direct Postgres (public proxy URL, not *.railway.internal):
# POS_DATABASE_URL="postgresql://..."
# POS_DATABASE_SSL=true
