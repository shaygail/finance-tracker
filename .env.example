# Production / local Postgres (Railway, Neon, or Docker)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Auth — generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Demo features
MOCK_GMAIL=true

# Gmail OAuth — real invoice inbox sync (see docs/GMAIL-INTEGRATION.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# GMAIL_SEARCH_QUERY=has:attachment (subject:invoice OR subject:receipt OR "tax invoice") newer_than:2y

# Optional — accountant invite emails
# RESEND_API_KEY=
# EMAIL_FROM="Finance Tracker <onboarding@resend.dev>"
# RESEND_FROM_EMAIL="Finance Tracker <onboarding@resend.dev>"
